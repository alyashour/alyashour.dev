---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { Image } from "astro:assets";
import dynTransport from "../assets/images/dyn_transport.png";
import mnistLecture from "../assets/images/mnist_lecture.jpg";
import gerstnerWaves from "../assets/images/gernster-waves.gif";
import marchingCubes from "../assets/images/marching-cube-demo.gif";
---

<SiteLayout title="Aly Ashour" active="about">
  <div id="about" class="hero">
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <h2 class="hero-heading">Hi, I'm Aly!</h2>
        <p class="hero-lede">I'm a computer engineer.</p>
        <h3 class="hero-subheading">I'm interested in:</h3>
        <ul class="hero-list">
          <li>
            <b>Robotics</b> — autonomous vehicles (see WE Autopilot below) and
            automation.
          </li>
          <li>
            <b>Social impact</b> — building tools that help people, improve lives,
            and make the world better.
          </li>
          <li>
            <b>Global solutions</b> — especially for public systems like transit,
            safety, or accessibility.
          </li>
        </ul>
        <p class="hero-lede hero-lede-last">
          Outside of engineering I love space, physics, and ancient history.
        </p>
      </div>
      <div class="hero-side">
        <div class="panel">
          <div class="panel-title">~/wips/</div>
          <div class="panel-grid">
            <span>Qualcomm — AISW Intern</span><span class="panel-meta"
              >current</span
            >
            <span>Robotic arm</span><span class="panel-meta"
              >4-axis, 3D printed</span
            >
            <a href="https://weautopilot.com">WE Autopilot P&amp;C</a><span
              class="panel-meta">20 developers</span
            >
          </div>
        </div>
        <div class="panel">
          <div class="panel-title">~/reading-list/</div>
          <div class="panel-grid">
            <span>Modern C</span><span class="panel-meta">Jens Gustedt</span>
            <span>Fighting the Great War</span><span class="panel-meta"
              >M.S. Neiberg</span
            >
            <span>Nineteen Eighty-Four</span><span class="panel-meta"
              >George Orwell</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="divider"></div>
  </div>

  <div id="experience" class="section experience-section">
    <h2 class="section-heading">Experience</h2>
    <div class="timeline">
      <div class="timeline-row">
        <div class="timeline-date">Current</div>
        <div class="timeline-main">
          <h4 class="timeline-role">AISW Engineering Intern</h4>
          <div class="timeline-org">Qualcomm</div>
        </div>
      </div>
      <div class="timeline-row">
        <div class="timeline-date">Current</div>
        <div class="timeline-main timeline-main-split">
          <div class="timeline-detail">
            <h4 class="timeline-role">
              Founder, President, Planning &amp; Control Lead
            </h4>
            <div class="timeline-org">
              <a href="https://weautopilot.com">WE Autopilot</a>
            </div>
            <div class="timeline-desc">
              Building a self-driving car at Western University
            </div>
          </div>
          <Image
            src={mnistLecture}
            alt="Teaching a lecture on MNIST digit classification at WE Autopilot"
            width={380}
            loading="eager"
            fetchpriority="high"
            class="thumb timeline-image"
          />
        </div>
      </div>
      <div class="timeline-row timeline-row-last">
        <div class="timeline-date">In progress</div>
        <div class="timeline-main">
          <h4 class="timeline-role">B.Eng, Software Engineering</h4>
          <div class="timeline-org">Western University</div>
        </div>
      </div>
    </div>
  </div>

  <div id="projects" class="section projects-section">
    <div class="section-header">
      <h2 class="section-heading section-heading-flush">Selected projects</h2>
      <a href="/projects/" class="see-all-link">See all →</a>
    </div>
    <div class="project-grid">
      <ProjectCard
        href="/projects/gerstner-waves/"
        image={gerstnerWaves}
        imageAlt="Gerstner waves water shader"
        title="Gerstner Waves Water Shader"
        variant="compact"
        tech="C++ · OpenGL"
      />
      <ProjectCard
        href="/projects/marching-cubes/"
        image={marchingCubes}
        imageAlt="Marching cubes surface extraction"
        title="Marching Cubes Surface Extraction"
        variant="compact"
        tech="Python · OpenGL"
      />
      <ProjectCard
        href="/projects/dynamic-transport/"
        image={dynTransport}
        imageAlt="Dynamic transport network design system"
        title="Dynamic Transport Network Design System"
        variant="compact"
        tech="Python · Machine Learning"
      />
    </div>
  </div>

  <div id="contact" class="section contact-section">
    <div class="divider contact-divider"></div>
    <h2 class="section-heading">Get in touch</h2>
    <p class="lede contact-lede">Reach me on GitHub or LinkedIn.</p>
    <div class="contact-actions">
      <a href="https://github.com/alyashour" class="btn btn-outline"
        >github.com/alyashour</a
      >
      <a
        href="https://www.linkedin.com/in/alymashour/"
        class="btn btn-secondary">linkedin.com/in/alymashour</a
      >
    </div>
  </div>
</SiteLayout>

<style>
  .hero {
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
    padding: 110px 32px 80px;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background:
      url("https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Colosse_de_Rhodes_%28Barclay%29.jpg/960px-Colosse_de_Rhodes_%28Barclay%29.jpg")
      center 25% / cover no-repeat;
    filter: sepia(0.45) saturate(0.65) contrast(1.05) brightness(0.95);
    opacity: 0.75;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(243, 242, 242, 0.55) 0%,
      #f3f2f2 78%
    );
  }

  .hero-content {
    position: relative;
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1.6 1 380px;
    text-align: justify;
  }

  .hero-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 30px;
    margin: 0 0 18px;
  }

  .hero-lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .hero-lede-last {
    margin: 0;
  }

  .hero-subheading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    margin: 24px 0 10px;
  }

  .hero-list {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    padding-left: 20px;
    margin: 0 0 18px;
  }

  .hero-list li {
    margin: 3px 0;
  }

  .hero-side {
    flex: 1 1 260px;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .panel {
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    padding: 24px;
    background: var(--color-panel-bg);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 21px;
    color: var(--color-accent);
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 14px;
    column-gap: 16px;
    font-size: 14px;
  }

  .panel-meta {
    color: var(--color-text-faint);
    text-align: right;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 30px;
    margin: 0 0 36px;
  }

  .section-heading-flush {
    margin: 0;
  }

  .experience-section {
    padding: 70px 32px 80px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-row {
    display: flex;
    gap: 40px;
    padding: 22px 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline-row-last {
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-date {
    flex: 0 0 150px;
    font-size: 13px;
    color: var(--color-text-faint);
    padding-top: 2px;
  }

  .timeline-main {
    flex: 1;
  }

  .timeline-main-split {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .timeline-detail {
    flex: 1 1 300px;
  }

  .timeline-role {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 19px;
    margin: 0 0 4px;
  }

  .timeline-org {
    font-size: 13.5px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .timeline-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .timeline-image {
    width: 190px;
    height: 140px;
    object-fit: cover;
    flex: none;
  }

  .projects-section {
    padding: 0 32px 90px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 36px;
  }

  .see-all-link {
    font-size: 14px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
  }

  .contact-section {
    padding: 0 32px 90px;
  }

  .contact-divider {
    margin-bottom: 60px;
  }

  .contact-lede {
    margin: 0 0 24px;
  }

  .contact-actions {
    display: flex;
    gap: 14px;
  }
</style>

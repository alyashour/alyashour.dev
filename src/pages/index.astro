---
import BaseLayout from "../layouts/BaseLayout.astro";
import Columns from "../layouts/Columns.astro";
import Table from "../components/Table.astro";
import CardSideScroller from "../layouts/CardSideScroller.astro";

// TEMP
const cwoData = [
	{ Title: "Portfolio", Description: "You're here!", Link: "https://www.alyashour.dev"},
	{ Title: "Robotic Arm", Description: "4 axis, partially 3D printed.", Link: "" },
	{ Title: "Autopilot P&C Team Principal", Description: "20 developers.", Link: "https://weautopilot.com"},
];

const subpages = [
	{ Title: "Projects", Link: "/projects/" },
	{ Title: "Roadmap", Link: "/roadmap/" }, 
	{ Title: "WE Autopilot", Link: "/weap/" },
];

const readingList = [
	{ Title: "Modern C", Author: "Jens Gustedt" },
	{ Title: "Fighting the Great War", Author: "MS. Neiberg" },
	{ Title: "Nineteen Eighty-Four", Author: "George Orwell" },
];

const cards = [
	{
		Title: "Dynamic Transport Network Design System",
		Image: "/dyn_transport.png",
		ImageAlt: "Dynamic Transport Dataset Visualization",
		Tags: ["Python", "Machine Learning"],
		GitHubLink: "https://github.com/alyashour/Dyn-Transport-Route-Design-System"
	},
	{ 
		Title: "Gerstner Waves Water Shader", 
		Image: "/gerstner_waves.avif", 
		ImageAlt: "Waves Graphics Demo",
		Tags: ["C++", "OpenGL"],
		GitHubLink: "https://github.com/alyashour/Gerstner-waves"
	},
	{ 
		Title: "Marching Cubes Surface Extraction", 
		Image: "/marching_cubes.avif", 
		ImageAlt: "Marching Cubes Demo",
		Tags: ["Python", "OpenGL"],
		GitHubLink: "https://github.com/alyashour/Marching-Cube-Renderer"
	},
	{ 
		Title: "Bezier Curve Editor", 
		Image: "/bezier_curve.avif", 
		ImageAlt: "Bezier Curve Demo",
		Tags: ["Python", "OpenGL"],
		GitHubLink: "https://github.com/alyashour/Bezier-Curve-Editor"
	},
]
---

<BaseLayout>
	<!-- Home page -->
	<!-- Left/right split -->
	<Columns>
		<!-- Main content section -->
		<section>
			<h2>Hi, I'm Aly</h2>
			<p>
				I'm a computer engineer!
			</p>

			<h3>What Drives Me</h3>

			<p>
				I'm interested in:	
			</p>
			<ul>
				<li>
					<b>Robotics</b> — This includes autonomous vehicles (check out WEAP), automation.
				</li>
				<li>
					<b>Social Impact</b> — Creating tools that help people, improve lives, and make the world better.
				</li>
				<li>
					<b>Global solutions</b> — especially for public systems like transit, safety, or accessibility.
				</li>
			</ul>
			<p>
				Outside of engineering I love space, physics, and ancient history.
			</p>
		</section>

		<!-- Aside, info section -->
		<aside>
			<h3>Currently working on <a href="">(+)</a></h3>
			<Table data={cwoData} linkKey="Link"/>

			<!-- For any child pages -->
			<h3>Subpage Index <a href="">(+)</a></h3>
			<Table data={subpages} linkKey="Link"/>

			<!-- The books I'm reading -->
			<h3>Currently Reading</h3>
			<Table data={readingList} />
		</aside>
	</Columns>

	<!-- Projects -->
	<div>
		<h2>Projects</h2>
		<p>
			Here are some of my favourites!
		</p>

		<CardSideScroller cards={cards} />

		<p><b>See more <a href="/projects/">here</a>!</b></p>
	</div>
</BaseLayout>

<style>
	section {
		flex: 2 1 0;
	}

	aside {
		flex: 1 1 0;
	}

	ul li {
		margin: 0.5em 0;
	}
</style>
